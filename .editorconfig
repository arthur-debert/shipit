# Shell source uses the repo style; extensionless projected launchers keep shfmt defaults.
root = true

[*.sh]
indent_style = space
indent_size = 4
switch_case_indent = true
binary_next_line = true

# Match the consumer projection, where no shipit-owned .editorconfig applies.
[{src/shipit/data/bootstrap/setup-dev-env.sh,bin/setup-dev-env.sh}]
indent_style = tab
switch_case_indent = false
binary_next_line = false
