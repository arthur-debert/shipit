#!/usr/bin/env bash
# Launch an isolated coordinator through an agent-specific strategy.
# Do not edit — `shipit install` overwrites this file.
set -euo pipefail

# Resolve relative link targets against their physical containing directory,
# but preserve the caller's logical checkout path at the final step.
resolve_script_dir() {
	local path="$1" link dir dirpath hops=0
	while [ -L "$path" ]; do
		hops=$((hops + 1))
		if [ "$hops" -gt 40 ]; then
			echo "agent-start: symlink loop resolving $1 — using it as-is" >&2
			break
		fi
		if ! dir="$(cd -P -- "$(dirname -- "$path")" && pwd)"; then
			echo "agent-start: could not resolve the directory holding $path — using it as-is" >&2
			break
		fi
		if ! link="$(readlink -- "$path")"; then
			echo "agent-start: could not read the symlink $path — using it as-is" >&2
			break
		fi
		case "$link" in
		/*) path="$link" ;;
		*) path="${dir}/${link}" ;;
		esac
	done
	# Degrade resolution failures here; the final repo `cd` remains fail-closed.
	dirpath="$(dirname -- "$path")" || dirpath="$path"
	if ! dir="$(cd -- "$dirpath" && pwd)"; then
		echo "agent-start: could not resolve the directory holding $path — using it as-is" >&2
		printf '%s\n' "$dirpath"
		return 0
	fi
	printf '%s\n' "$dir"
}

repo="$(resolve_script_dir "${BASH_SOURCE[0]}")"

cd -- "$repo"

# A coordinator must not inherit a worker Run's identity.
unset SHIPIT_LOG_CTX_ROLE SHIPIT_LOG_CTX_AGENT SHIPIT_LOG_CTX_RUN

usage() {
	echo "usage: agent-start <agent> [args...]   (agents: claude, codex)" >&2
	exit 64
}

launch_claude() {
	exec claude --worktree "sess-$(date -u +%Y%m%d-%H%M%S)-$$" "$@"
}

launch_codex() {
	if [ ! -x "$repo/bin/shipit" ]; then
		echo "agent-start: $repo/bin/shipit is missing or not executable — run 'shipit install' to (re)provision the pinned launcher." >&2
		exit 127
	fi
	exec "$repo/bin/shipit" session codex "$@"
}

[ "$#" -ge 1 ] || usage
agent="$1"
shift

case "$agent" in
claude) cli="claude" product="Claude Code" launch="launch_claude" ;;
codex) cli="codex" product="Codex" launch="launch_codex" ;;
*)
	echo "agent-start: unknown agent '$agent' (supported: claude, codex)" >&2
	exit 64
	;;
esac

if ! command -v "$cli" >/dev/null 2>&1; then
	echo "agent-start: the $cli CLI is not on PATH — install $product first." >&2
	exit 127
fi

"$launch" "$@"
